rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'pamelapayanocaceres@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'address']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['student', 'admin'] &&
             data.address is string && data.address.size() <= 200 &&
             (!('courses' in data) || data.courses is list);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'timestamp']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.message is string && data.message.size() <= 2000 &&
             data.timestamp == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'timestamp']) &&
             data.action is string && data.action.size() <= 100 &&
             data.timestamp == request.time &&
             (!('userId' in data) || data.userId is string) &&
             (!('status' in data) || data.status is string);
    }

    // --- Collection Match Blocks ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().role == 'student' && 
                    incoming().id == userId;
                    
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'profilePic', 'bio', 'courses', 'lastLogin'])) &&
        (incoming().role == existing().role) &&
        (incoming().email == existing().email)
      ) || isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if false; // Only manageable via console or trusted service
    }

    match /messages/{messageId} {
      allow get, list: if isAdmin();
      allow create: if isValidMessage(incoming()) && isValidId(messageId);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if (isSignedIn() || isAdmin()) && isValidAuditLog(incoming()) && isValidId(logId);
    }
  }
}
